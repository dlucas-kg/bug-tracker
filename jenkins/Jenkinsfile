pipeline {
    agent any

    tools { 
        go '1.26.2' //it has to coincide with the plugin installed version 
      //nodejs 'NodeJS' //it has to coincide with the Name in tool config 
    }                   

    stages {
        stage('Execute Unit Tests'){
            parallel{
                stage('Unit Test - Backend') {
            // agent{
            //     docker {                              //pulling a docker instance with everything needed to run the tests
            //         image 'snakee/golang-junit:1.21' //it can be repleaced by a jenkins plugin tho
            //         reuseNode true
            //     }
            // }
                    steps {
                        dir('bugtracker-backend'){
                            sh '''
                                go test -v ./...
                                
                                #Generate cover reports
                                go test -coverprofile=coverage.out -covermode=atomic ./...
                                go tool cover -html=coverage.out -o coverage.html
                                
                                mkdir -p reports
                                mv coverage.html reports/
                                '''
                        }
                    }
                    post{
                        always{
                            //junit 'bugtracker-frontend/test-result.xml' //this is a way to do it, but need to run test locally, which doesn't makes sense for this implementation
                            publishHTML target:[
                                reportDir: 'bugtracker-backend/reports',
                                reportFiles: 'coverage.html',
                                reportName: 'Backend Coverage Report'
                            ]
                        }
                    }
                }

                stage('Unit Test - Frontend'){
                    agent { 
                        docker { 
                            image 'node:18-alpine' 
                            reuseNode true    
                        } 

                    }
                    steps{
                        dir('bugtracker-frontend'){
                            sh '''
                                npm ci 
                                npm test
                                mkdir -p reports
                                mv coverage reports/ 
                            '''
                        }
                    }
                    post{
                        always{
                            //junit 'bugtracker-frontend/test-result.xml' //this is a way to do it, but need to run test locally, which doesn't makes sense for this implementation
                            publishHTML target:[
                                reportDir: 'bugtracker-frontend/reports/coverage',
                                reportFiles: 'index.html',
                                reportName: 'Frontend Coverage Report'
                            ]
                        
                        }
                    }
                }
            }
        }
        stage('Lunch Application'){
            agent{
                docker{
                    image 'docker:27.5.1'
                    reuseNode true
                    args '-v /var/run/docker.sock:/var/run/docker.sock -u 0'
                }
            }
            steps{
                sh 'docker compose up --build -d'
            }
        }
        stage('Api Tests'){
            agent{
                docker{
                    image 'mcr.microsoft.com/playwright:v1.50.0-jammy'
                    reuseNode true
                    args '-u 0 --network=host'
                }
            }
            steps{
                dir('tests-api'){
                    sh 'npx wait-port http://localhost:8080/api/health -t 30000'

                    sh 'npm ci'
                    sh 'npx playwright test'
                }
            }
        }
    }
    post{
        always{
            cleanWs()
        }
    }
}